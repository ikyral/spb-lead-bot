BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TG_ID=123456789
# ADMIN_TG_ID — главный владелец бота: за ним закрепляются старые лиды при запуске.
# Дополнительные администраторы (операторы) через запятую:
# берут и ведут лиды, но не управляют сбором и не выгружают CSV
ADMIN_TG_IDS=
# Дополнительные владельцы с теми же правами, что у ADMIN_TG_ID. Числовые Telegram ID через запятую,
# не @username, например 111111111,222222222. ID из обоих списков считается владельцем
ADMIN_TG_OWNER_IDS=
# Группы для уведомлений о сборе (итоги, ошибки, блокировки) через запятую. Пусто = только админам в личку.
# Как узнать ID: добавьте бота в группу и отправьте там команду /chat_id. ID групп отрицательные: -1001234567890
NOTIFY_CHAT_IDS=
# Отправлять то же самое админам в личку. Если групп нет, админы получают уведомления в любом случае
NOTIFY_ADMINS_PRIVATE=true
DB_URL=sqlite+aiosqlite:///./leads.db

# Выдача лидов пачками
LEADS_BATCH_SIZE=30
# Внеочередной сбор, если новых лидов меньше этого числа (не чаще раза в час; 0 = не запускать)
LEADS_MIN_POOL=60
# false: организация из 2ГИС без телефона и сайта считается лидом, контакты смотрят в её карточке по ссылке
# true: нужны телефон или сайт, как раньше (и доступ к контактам в API)
LEADS_REQUIRE_CONTACT=false
# false: лиды, о сайте которых ничего не известно (статус unknown), не выдаются вообще.
# С демо-ключом 2ГИС таких почти все, поэтому при false выдавать будет почти нечего
LEADS_ISSUE_UNKNOWN=true
# Наибольшая доля одной ниши в пачке, от 0 до 1. 1 = без ограничения. Если в запасе одна ниша, пачка будет неполной
LEADS_MAX_NICHE_SHARE=0.5
# С какого числа филиалов (разных адресов с одним названием) организация считается сетью и не выдаётся
LEADS_CHAIN_MIN_BRANCHES=3
# Бренды через запятую, заменяют список из src/services/chains.py. Пусто = список из кода
LEADS_CHAIN_BLOCKLIST=

# Первое сообщение под карточкой лида без сайта или с неработающим сайтом.
# Одна фраза о том, что вы предлагаете. Пусто = нейтральный текст. Пример:
# OUTREACH_OFFER=Я делаю сайты и лендинги для небольших бизнесов и могу показать пример для вас бесплатно.
OUTREACH_OFFER=
# Подпись и способ связи. Пусто = «Хорошего дня!». Пример:
# OUTREACH_SIGNATURE=Иван, веб-разработчик. Telegram: @ivan_dev
OUTREACH_SIGNATURE=

# Утренний план для администраторов: напоминания, полезные лиды в запасе, ждущие обогащения, остаток запросов 2ГИС.
# Приходит туда же, куда уведомления о сборе (NOTIFY_CHAT_IDS, NOTIFY_ADMINS_PRIVATE). Время по COLLECT_TIMEZONE.
DIGEST_ENABLED=true
DIGEST_TIME=09:30
# «Написал» без ответа дольше стольких дней попадает в «пора напомнить», даже без напоминания
FOLLOWUP_AFTER_DAYS=3

# Закрепление лидов. «Написал» закрепляет лид за нажавшим на столько дней, потом он возвращается в пул (от 1).
# «Ответили» закрепляет без срока, «Нет ответа» — на сутки
LEAD_OWNERSHIP_DAYS=30
# Файл запроса для обогащения (/export_unknown) резервирует свои лиды за запросившим на столько часов: другим они не выдаются (от 1)
EXPORT_RESERVE_HOURS=6

# Автоматический сбор. Значения ниже совпадают со значениями по умолчанию.
# COLLECT_ENABLED=false или пустой COLLECT_PROVIDERS: сервер сам не собирает, лиды приходят файлами с внешнего сборщика
COLLECT_ENABLED=true
COLLECT_CRON=0 4 * * *
# Если задан интервал в минутах, он заменяет COLLECT_CRON
COLLECT_INTERVAL_MINUTES=
COLLECT_TIMEZONE=Europe/Moscow
COLLECT_RUN_ON_START=false

# Что и где искать
# Через запятую: 2gis_cdp (браузерный парсер 2ГИС, см. раздел про сервер в README), osm, 2gis_scraper (по умолчанию выключен).
# Старое имя 2gis (API) удалено: оно читается как 2gis_cdp, в лог пишется предупреждение
COLLECT_PROVIDERS=2gis_cdp,osm
# Ключи ниш (dentist_clinic, auto_repair, beauty, legal_b2b, horeca, hotels) и/или свои запросы; пусто = все ниши
COLLECT_QUERIES=
# Районы СПб через запятую; пусто = все
COLLECT_DISTRICTS=
# Своя область вместо районов: юг,запад,север,восток
COLLECT_BBOX=

# Лимиты
COLLECT_MAX_PAGES=2
COLLECT_PAGE_SIZE=50
COLLECT_MAX_RESULTS_PER_QUERY=100
COLLECT_MAX_REQUESTS_PER_RUN=60
COLLECT_MAX_REQUESTS_PER_DAY=200
# Организация, чей сайт браузерный парсер 2ГИС уже проверил (таблица place_checks), не открывается снова
# столько дней, потом проверяется заново. От 1 до 365, значения вне диапазона приводятся к границе
SITE_RECHECK_DAYS=30

# Импорт файлов выгрузки на сервере
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_LEADS=2000
# Папка для файлов, загруженных через scp или SFTP. Обработанные попадают в done/ и failed/
IMPORT_INBOX_DIR=data/inbox
# Как часто проверять папку; 0 = не проверять
IMPORT_INBOX_INTERVAL_SECONDS=300

# Сборщик на отдельном компьютере (collect_cli.py). BOT_TOKEN и ADMIN_TG_ID ему не нужны
COLLECTOR_PROVIDERS=2gis_cdp
COLLECTOR_DB_PATH=data/collector.db
COLLECTOR_EXPORT_DIR=exports

# Город в ссылках на карточки 2ГИС
SCRAPER_CITY_SLUG=spb
# Парсер публичных страниц 2ГИС. Перед использованием прочитайте раздел об ограничениях в README
# Случайная пауза между страницами, секунды (минимум 3)
SCRAPER_MIN_DELAY_SECONDS=3
SCRAPER_MAX_DELAY_SECONDS=8
SCRAPER_MAX_PAGES_PER_RUN=200
SCRAPER_MAX_RESULTS_PER_RUN=300
# Сайт посещается не чаще этого, в том числе при внеочередных сборах. 0 = интервал выключен, когда запускать, решаете вы.
# Настройка действует и на бота, если у него включён 2gis_scraper. Паузы после блокировок и лимиты от неё не зависят
SCRAPER_MIN_HOURS_BETWEEN_RUNS=20
# Пауза после капчи, 403 или 429; удваивается, после третьей блокировки подряд парсер отключается
SCRAPER_BLOCK_BACKOFF_HOURS=6
SCRAPER_PAGE_TIMEOUT_SECONDS=45
# false показывает окно браузера. Только для ручной отладки, не для расписания
SCRAPER_HEADLESS=true
# Сбор с участием человека, только на компьютере с экраном (см. README). Бот на сервере эти настройки не использует
# true: то же, что collect_cli.py --assisted, при каждом запуске. Не включайте для запуска по расписанию
SCRAPER_ASSISTED=false
# Здесь хранятся cookies браузера между запусками
SCRAPER_PROFILE_DIR=data/browser_profile
# Сколько минут ждать, пока человек пройдёт капчу
SCRAPER_ASSISTED_WAIT_MINUTES=5
# Сколько раз за запуск можно просить пройти капчу; следующая капча считается блокировкой
SCRAPER_ASSISTED_MAX_CAPTCHAS=2
# Сколько раз за 24 часа можно запускать collect_cli.py --assisted --check, от 1 до 10
SCRAPER_CHECK_MAX_PER_DAY=3
# 2 страницы за проверку и 30 карточек за запуск в --enrich заданы в коде, чтобы их нельзя было поднять настройкой

# Парсер 2gis_cdp: Chrome, основной источник лидов (расписание бота и collect_cli.py). Пакеты ставятся из requirements.txt.
# На сервере без экрана Chrome идёт под виртуальным экраном Xvfb (см. раздел «Сервер и прокси» в README)
# Пауза перед каждым кликом и переходом по страницам, секунды. Меньше 3 поставить нельзя
SCRAPER_CDP_MIN_DELAY_SECONDS=3
SCRAPER_CDP_MAX_DELAY_SECONDS=8
# Лимит загрузок страниц поиска за запуск (первая страница цели и переход по пагинации), от 1 до 200
SCRAPER_CDP_MAX_PAGES_PER_RUN=60
# Организаций за запуск, от 1 до 300
SCRAPER_CDP_MAX_RESULTS_PER_RUN=30
# Лимит кликов по карточкам за запуск, повторные попытки тоже, от 0 до 300. 0 = как SCRAPER_CDP_MAX_RESULTS_PER_RUN;
# значение больше SCRAPER_CDP_MAX_RESULTS_PER_RUN автоматически снижается до него
SCRAPER_CDP_MAX_CARD_CLICKS_PER_RUN=0
# Часов между запусками. Паузы после блокировок берутся из SCRAPER_BLOCK_BACKOFF_HOURS, город из SCRAPER_CITY_SLUG
SCRAPER_CDP_MIN_HOURS_BETWEEN_RUNS=20
# Сколько ждать загрузки страницы, секунды (минимум 5)
SCRAPER_CDP_PAGE_TIMEOUT_SECONDS=45
# Путь к chrome.exe; пусто = найти автоматически
SCRAPER_CDP_CHROME_PATH=
# Прокси с российским IP: схема://[логин:пароль@]хост:порт (http, https, socks5 без пароля). Спецсимволы пароля писать
# в виде %XX (@ это %40, : это %3A, / это %2F, # это %23). Пароль никогда не попадает в логи и уведомления
TWOGIS_PROXY=
# Страна внешнего IP, проверяется в самом браузере до первого запроса к 2ГИС. Другая страна или нерабочий прокси:
# сбор останавливается, админам уходит уведомление (это не блокировка 2ГИС). off = не проверять
TWOGIS_PROXY_COUNTRY=RU
# Профиль Chrome сохраняется здесь между запусками (cookies). Старое имя SCRAPER_CDP_PROFILE_DIR тоже читается
TWOGIS_PROFILE_DIR=data/cdp_profile
# Часовой пояс и язык браузера: под место прокси
TWOGIS_TIMEZONE=Europe/Moscow
TWOGIS_LANG=ru-RU
# false: обычное окно (на сервере под Xvfb). true: без окна, только если экрана нет совсем
TWOGIS_HEADLESS=false
# Память Chrome (для маленького сервера). Лимит кучи V8 в МБ: от 100, 0 = как решит Chrome (75% оперативной памяти)
TWOGIS_CHROME_MEMORY_MB=300
# Облегчённый режим: без картинок, шрифтов, тайлов карты и стилей, один процесс отрисовки, без расширений.
# Логи, метрики и реклама самого 2ГИС не блокируются. Карточки читаются так же
TWOGIS_LIGHT_MODE=true
# Через сколько прочитанных карточек Chrome запускается заново (профиль и cookies остаются), 0 = не перезапускать
TWOGIS_RESTART_EVERY_CARDS=20
# Только для диагностики: папка, куда сохраняется каждая страница поиска (HTML и список ссылок). Пусто = не сохранять.
# В снимке данные организаций с публичной страницы: папку не передавать и не добавлять в git
TWOGIS_SNAPSHOT_DIR=

# Поиск сайта и контактов лидов в Google: только collect_cli.py --assisted --google --enrich ФАЙЛ (см. README)
# Лидов за запуск, от 1 до 20
GOOGLE_MAX_PER_RUN=15
# Поисковых запросов за календарный день этого компьютера, от 1 до 100
GOOGLE_MAX_PER_DAY=60
# Часов между запусками, считается отдельно от 2ГИС. 0 = интервал выключен
GOOGLE_MIN_HOURS_BETWEEN_RUNS=3
# Насколько название лида должно совпасть с доменом или заголовком результата, от 0.5 до 1
GOOGLE_NAME_MATCH_THRESHOLD=0.6
# Cookies браузера для Google, отдельно от профиля 2ГИС
GOOGLE_PROFILE_DIR=data/google_profile
# Пауза 10–25 секунд между поисками и 5 первых результатов заданы в коде
