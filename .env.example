BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TG_ID=123456789
# Дополнительные администраторы через запятую
ADMIN_TG_IDS=
# Группы для уведомлений о сборе (итоги, ошибки, блокировки) через запятую. Пусто = только админам в личку.
# Как узнать ID: добавьте бота в группу и отправьте там команду /chat_id. ID групп отрицательные: -1001234567890
NOTIFY_CHAT_IDS=
# Отправлять то же самое админам в личку. Если групп нет, админы получают уведомления в любом случае
NOTIFY_ADMINS_PRIVATE=true
# Ключ API 2ГИС: основной источник лидов и ручной поиск. Без ключа источник 2gis пропускается
DGIS_API_KEY=
# true: демо-ключ, запросы не больше 10 объектов на странице и 5 страниц. false только для платного ключа
DGIS_DEMO_KEY=true
# true: запрашивать телефоны и сайты (items.contact_groups). Нужен платный доступ через отдел продаж 2ГИС
DGIS_REQUEST_CONTACTS=false
# Всего запросов на один ключ, 0 = без ограничения. Сбор останавливается за DGIS_REQUEST_RESERVE запросов до лимита
DGIS_REQUEST_LIMIT=1000
DGIS_REQUEST_RESERVE=50
# Дата создания ключа, ГГГГ-ММ-ДД. Демо-ключ живёт 30 дней; необязательно, без даты предупреждений о сроке не будет
DGIS_KEY_CREATED_AT=
# За сколько дней до окончания срока предупреждать администраторов
DGIS_KEY_WARN_DAYS=5
DB_URL=sqlite+aiosqlite:///./leads.db

# Выдача лидов пачками
LEADS_BATCH_SIZE=30
# Внеочередной сбор, если новых лидов меньше этого числа (не чаще раза в час; 0 = не запускать)
LEADS_MIN_POOL=60
# false: организация из 2ГИС без телефона и сайта считается лидом, контакты смотрят в её карточке по ссылке
# true: нужны телефон или сайт, как раньше (и доступ к контактам в API)
LEADS_REQUIRE_CONTACT=false
# false: лиды, о сайте которых ничего не известно (статус unknown), не выдаются вообще.
# С демо-ключом 2ГИС таких почти все, поэтому при false выдавать будет почти нечего
LEADS_ISSUE_UNKNOWN=true
# Наибольшая доля одной ниши в пачке, от 0 до 1. 1 = без ограничения. Если в запасе одна ниша, пачка будет неполной
LEADS_MAX_NICHE_SHARE=0.5
# С какого числа филиалов (разных адресов с одним названием) организация считается сетью и не выдаётся
LEADS_CHAIN_MIN_BRANCHES=3
# Бренды через запятую, заменяют список из src/services/chains.py. Пусто = список из кода
LEADS_CHAIN_BLOCKLIST=

# Автоматический сбор. Значения ниже совпадают со значениями по умолчанию.
# COLLECT_ENABLED=false или пустой COLLECT_PROVIDERS: сервер сам не собирает, лиды приходят файлами с внешнего сборщика
COLLECT_ENABLED=true
COLLECT_CRON=0 4 * * *
# Если задан интервал в минутах, он заменяет COLLECT_CRON
COLLECT_INTERVAL_MINUTES=
COLLECT_TIMEZONE=Europe/Moscow
COLLECT_RUN_ON_START=false

# Что и где искать
# Через запятую: 2gis (API, нужен ключ), osm, 2gis_scraper (парсер, по умолчанию выключен, см. ограничения в README)
COLLECT_PROVIDERS=2gis,osm
# Ключи ниш (dentist_clinic, auto_repair, beauty, legal_b2b, horeca, hotels) и/или свои запросы; пусто = все ниши
COLLECT_QUERIES=
# Районы СПб через запятую; пусто = все
COLLECT_DISTRICTS=
# Своя область вместо районов: юг,запад,север,восток
COLLECT_BBOX=

# Лимиты: каждая страница 2ГИС расходует квоту ключа
COLLECT_MAX_PAGES=2
# С демо-ключом (DGIS_DEMO_KEY=true) для 2ГИС автоматически снижается до 10
COLLECT_PAGE_SIZE=50
COLLECT_MAX_RESULTS_PER_QUERY=100
COLLECT_MAX_REQUESTS_PER_RUN=60
COLLECT_MAX_REQUESTS_PER_DAY=200
# Запрос к API 2ГИС, пройденный до последней страницы, не повторяется столько дней
COLLECT_RECHECK_DAYS=30

# Импорт файлов выгрузки на сервере
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_LEADS=2000
# Папка для файлов, загруженных через scp или SFTP. Обработанные попадают в done/ и failed/
IMPORT_INBOX_DIR=data/inbox
# Как часто проверять папку; 0 = не проверять
IMPORT_INBOX_INTERVAL_SECONDS=300

# Сборщик на отдельном компьютере (collect_cli.py). BOT_TOKEN и ADMIN_TG_ID ему не нужны
COLLECTOR_PROVIDERS=2gis
COLLECTOR_DB_PATH=data/collector.db
COLLECTOR_EXPORT_DIR=exports

# Город в ссылках на карточки 2ГИС
SCRAPER_CITY_SLUG=spb
# Парсер публичных страниц 2ГИС. Перед использованием прочитайте раздел об ограничениях в README
# Случайная пауза между страницами, секунды (минимум 3)
SCRAPER_MIN_DELAY_SECONDS=3
SCRAPER_MAX_DELAY_SECONDS=8
SCRAPER_MAX_PAGES_PER_RUN=200
SCRAPER_MAX_RESULTS_PER_RUN=300
# Сайт посещается не чаще этого, в том числе при внеочередных сборах. 0 = интервал выключен, когда запускать, решаете вы.
# Настройка действует и на бота, если у него включён 2gis_scraper. Паузы после блокировок и лимиты от неё не зависят
SCRAPER_MIN_HOURS_BETWEEN_RUNS=20
# Пауза после капчи, 403 или 429; удваивается, после третьей блокировки подряд парсер отключается
SCRAPER_BLOCK_BACKOFF_HOURS=6
SCRAPER_PAGE_TIMEOUT_SECONDS=45
# false показывает окно браузера. Только для ручной отладки, не для расписания
SCRAPER_HEADLESS=true
# Сбор с участием человека, только на компьютере с экраном (см. README). Бот на сервере эти настройки не использует
# true: то же, что collect_cli.py --assisted, при каждом запуске. Не включайте для запуска по расписанию
SCRAPER_ASSISTED=false
# Здесь хранятся cookies браузера между запусками
SCRAPER_PROFILE_DIR=data/browser_profile
# Сколько минут ждать, пока человек пройдёт капчу
SCRAPER_ASSISTED_WAIT_MINUTES=5
# Сколько раз за запуск можно просить пройти капчу; следующая капча считается блокировкой
SCRAPER_ASSISTED_MAX_CAPTCHAS=2
# Сколько раз за 24 часа можно запускать collect_cli.py --assisted --check, от 1 до 10
SCRAPER_CHECK_MAX_PER_DAY=3
# 2 страницы за проверку и 30 карточек за запуск в --enrich заданы в коде, чтобы их нельзя было поднять настройкой

# Поиск сайта и контактов лидов в Google: только collect_cli.py --assisted --google --enrich ФАЙЛ (см. README)
# Лидов за запуск, от 1 до 20
GOOGLE_MAX_PER_RUN=15
# Поисковых запросов за календарный день этого компьютера, от 1 до 100
GOOGLE_MAX_PER_DAY=60
# Часов между запусками, считается отдельно от 2ГИС. 0 = интервал выключен
GOOGLE_MIN_HOURS_BETWEEN_RUNS=3
# Насколько название лида должно совпасть с доменом или заголовком результата, от 0.5 до 1
GOOGLE_NAME_MATCH_THRESHOLD=0.6
# Cookies браузера для Google, отдельно от профиля 2ГИС
GOOGLE_PROFILE_DIR=data/google_profile
# Пауза 10–25 секунд между поисками и 5 первых результатов заданы в коде
