# Секреты: передаются в контейнер через env_file, в образ попадать не должны
.env
.env.*
!.env.example

# Окружения, VCS и IDE
.venv/
venv/
env/
.git/
.idea/
.vscode/

# База данных монтируется томом (./db)
db/
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal

# Выгрузки лидов, логи и входящие файлы в образ не нужны
exports/
logs/
data/inbox/

# Кэш Python и тестов (в .dockerignore шаблоны без **/ действуют только в корне)
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Не нужны в рантайме (pytest в образ не ставится)
tests/
scripts/
requirements-dev.txt
